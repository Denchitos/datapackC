{
    print_string(test_function(10))
}


def test_void( a : score_bool)
{
    if ( a )
    {
        raw say a is true

        return 

        raw say You never see that in test_void
    }
    else
    {
        raw say a if false
    }

    raw say "AFTER RETURN"

    return
}

def run_test_v_0()
{
    test_void(false)
}

def run_test_v_1()
{
    test_void(true)
}
