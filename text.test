{
    let y : int = 27
    let user = @s
    let c : custom = { "Hello","World","!" }
    let b : bet = {5,c,5}

    let zoomba = b.b.c
    let hun : string = for_test(b).a
    let amo = for_test2(5)
    let xyz = b
    user.dms = 5
    user.say()
    let d : bet = { 5,{ "Hello","World","!" },5 }
    
    let zzz : int[] = { 55 , y ,66}

    let zzz2 : int[][] = { zzz,{5,5,5} }

    let zzz_item = zzz[5]
    let zzz_len = zzz.len()

    zzz_item = zzz2[1][0]


    if ( a>5 )
    {
        return 50
    }
    else return 25

    return 10
}